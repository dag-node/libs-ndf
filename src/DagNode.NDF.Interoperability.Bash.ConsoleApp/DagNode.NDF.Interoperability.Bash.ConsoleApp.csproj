<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Bash interop runs on Linux only, so pin the RID: AOT restore is then
             deterministic across SDK feature bands instead of inferring the host's. -->
        <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
        <PublishAot>true</PublishAot>
        <InvariantGlobalization>true</InvariantGlobalization>
        <!-- Sample/host app: never published as a NuGet package. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
      <!-- The library depends on the logging abstractions only; the app picks the provider. -->
      <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\DagNode.NDF.Interoperability.Core\DagNode.NDF.Interoperability.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="functions.sh" />
      <Content Include="functions.sh">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Remove="Scripts\___run_function__with__stdout_end_marker__async.sh" />
      <Content Include="Scripts\___run_function__with__stdout_end_marker__async.sh">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Remove="Scripts\___init_traps.sh" />
      <Content Include="Scripts\___init_traps.sh">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
