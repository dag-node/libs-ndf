<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <InvariantGlobalization>true</InvariantGlobalization>
        <RootNamespace>DagNode.NDF.Interoperability</RootNamespace>
    </PropertyGroup>

    <!-- Package identity. Shared metadata lives in ../Directory.Build.props. -->
    <PropertyGroup>
        <PackageId>DagNode.NDF.Interoperability.Core</PackageId>
        <Version>0.8.1</Version>
        <Description>Run and orchestrate Bash scripts and shell functions from .NET. Discovers shell functions, marshals arguments, and captures stdout, stderr, and exit codes, with asynchronous execution over FIFOs and PIDs on Linux.</Description>
        <PackageTags>bash;shell;interop;linux;process;automation;scripting;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    </ItemGroup>

</Project>
