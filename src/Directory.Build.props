<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Shared metadata and build settings for every DagNode.NDF.* package in this
    repository. Per-project .csproj files set only PackageId, Version,
    Description, and PackageTags. Set <IsPackable>false</IsPackable> in projects
    that must not be published (e.g. sample/console apps).
  -->

  <PropertyGroup>
    <!-- Ownership / identity -->
    <Authors>DagNode</Authors>
    <Company>DagNode</Company>
    <Product>NDF</Product>
    <Copyright>Copyright © 2026 DagNode</Copyright>

    <!-- Repository. Shared across all packages: SourceLink resolves commits here. -->
    <PackageProjectUrl>https://github.com/dag-node/libs-ndf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dag-node/libs-ndf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Licensing -->
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <!--
      Ship API docs with each package. CS1591 (missing XML comment) is suppressed while the
      documentation pass is in progress: the types a consumer starts from are documented,
      the internals behind them are not yet. Drop the NoWarn once that gap closes.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!--
      The SDK only enables the .NET analyzers by default for net5.0+ targets, so
      netstandard2.1 projects need it set explicitly.
    -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!--
      Reproducible builds and source debugging. SourceLink for GitHub ships in the .NET
      SDK (8+) and is enabled by default, so no PackageReference is needed; referencing
      the standalone package would override the SDK's copy with an older one.
    -->
    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- README, changelog and icon live at the repo root; each package sits one level below this file. -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)..\CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
